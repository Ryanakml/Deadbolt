{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "not": {
        "pattern": "[^a-zA-Z0-9_-]"
      }
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "recovery": {
      "enum": ["safe", "idempotent", "reconcile"]
    },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "initialDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 1000
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 30000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000,
      "default": 300000
    },
    "idempotencyWindowMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["name", "inputSchema", "outputSchema", "recovery"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runtime.invalid/task/1",
  "if": {
    "properties": {
      "recovery": {
        "const": "idempotent"
      }
    }
  },
  "then": {
    "required": ["idempotencyWindowMs"]
  }
}
