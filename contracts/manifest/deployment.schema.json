{
  "type": "object",
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "sdkVersion": {
      "type": "string"
    },
    "protocolMajor": {
      "const": 1
    },
    "nodeRuntimeMajor": {
      "const": 24
    },
    "targetOS": {
      "const": "linux"
    },
    "targetArchitecture": {
      "enum": ["amd64", "arm64"]
    },
    "dependencyLockDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "secretNames": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "not": {
          "pattern": "[^A-Za-z0-9_]"
        }
      },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "not": {
              "pattern": "[^a-zA-Z0-9_-]"
            }
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "recovery": {
            "enum": ["safe", "idempotent", "reconcile"]
          },
          "retry": {
            "type": "object",
            "properties": {
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 3
              },
              "initialDelayMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "default": 1000
              },
              "maxDelayMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "default": 30000
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000,
            "default": 300000
          },
          "idempotencyWindowMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "inputSchema",
          "outputSchema",
          "recovery",
          "entrypoint"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.runtime.invalid/task/1",
        "if": {
          "properties": {
            "recovery": {
              "const": "idempotent"
            }
          }
        },
        "then": {
          "required": ["idempotencyWindowMs"]
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "manifestVersion": {
            "const": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "not": {
              "pattern": "[^a-zA-Z0-9_-]"
            }
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$",
                  "not": {
                    "pattern": "[^a-zA-Z0-9_-]"
                  }
                },
                "type": {
                  "enum": ["task", "choice", "merge", "approval", "delay"]
                },
                "task": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$",
                  "not": {
                    "pattern": "[^a-zA-Z0-9_-]"
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$",
                    "not": {
                      "pattern": "[^a-zA-Z0-9_-]"
                    }
                  },
                  "uniqueItems": true
                },
                "input": {
                  "type": "object"
                },
                "sideEffect": {
                  "type": "boolean"
                },
                "choice": {
                  "type": "object"
                },
                "merge": {
                  "type": "object"
                },
                "approval": {
                  "type": "object"
                },
                "delayMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["id", "type"],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "task"
                      }
                    }
                  },
                  "then": {
                    "required": ["task"],
                    "not": {
                      "anyOf": [
                        {
                          "required": ["choice"]
                        },
                        {
                          "required": ["merge"]
                        },
                        {
                          "required": ["approval"]
                        },
                        {
                          "required": ["delayMs"]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "output": {
            "type": "object"
          }
        },
        "required": [
          "manifestVersion",
          "name",
          "inputSchema",
          "outputSchema",
          "nodes",
          "output"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.runtime.invalid/workflow/1",
        "$defs": {
          "Reference": {
            "type": "object",
            "properties": {
              "$ref": {
                "enum": ["run.input", "step.output"]
              },
              "stepId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$",
                "not": {
                  "pattern": "[^a-zA-Z0-9_-]"
                }
              },
              "pointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~]|~[01])*)*$"
              },
              "default": {}
            },
            "required": ["$ref", "pointer"],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "$ref": {
                      "const": "step.output"
                    }
                  }
                },
                "then": {
                  "required": ["stepId"]
                },
                "else": {
                  "not": {
                    "required": ["stepId"]
                  }
                }
              }
            ]
          },
          "Literal": {
            "type": "object",
            "properties": {
              "literal": {}
            },
            "required": ["literal"],
            "additionalProperties": false
          }
        },
        "description": "Versioned language contract. Control fields are reserved for V1. Executable M0/MVP validation rejects non-linear or non-task graphs; no control execution is enabled."
      }
    }
  },
  "required": [
    "manifestVersion",
    "sdkVersion",
    "protocolMajor",
    "nodeRuntimeMajor",
    "targetOS",
    "targetArchitecture",
    "dependencyLockDigest",
    "bundleDigest",
    "secretNames",
    "tasks",
    "workflows"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runtime.invalid/deployment/1"
}
